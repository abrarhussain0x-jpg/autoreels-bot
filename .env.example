# AUTO-REELS PRO v5.0 — Environment Variables
# =============================================
# Copy this file to .env and fill in your real values.
# Run: python main.py --setup  for interactive setup wizard.
#
# ⚠️  NEVER commit .env to git (it's in .gitignore)

# ── Required: Facebook ────────────────────────────────────────────────────────
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_TOKEN=your_long_lived_page_access_token_here

# ── Optional: TikTok ──────────────────────────────────────────────────────────
# Get from TikTok Developer Portal → your app → Content Posting API → OAuth2
TIKTOK_TOKEN=

# ── Optional: Instagram ───────────────────────────────────────────────────────
# Requires Instagram Business/Creator account linked to a Facebook Page
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=

# ── Optional: Telegram Notifications ─────────────────────────────────────────
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: Discord Notifications ──────────────────────────────────────────
# Server Settings → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK=

# ── Optional: AI Captions (NEW in v5.0) ──────────────────────────────────────
# Get from https://console.anthropic.com/
# Required only if ai_captions: true in config.yaml
ANTHROPIC_API_KEY=

# ── Optional: Git Auto-Push ───────────────────────────────────────────────────
GIT_REMOTE=origin
GIT_BRANCH=main
